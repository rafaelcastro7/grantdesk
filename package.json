{
  "name": "grantdesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:integration": "node node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node node_modules/playwright/cli.js test",
    "test:agents": "node node_modules/playwright/cli.js test tests/e2e/synthetic-agents.spec.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "db:up": "docker compose -p grantdesk -f supabase/docker-compose.yml up -d",
    "db:down": "docker compose -p grantdesk -f supabase/docker-compose.yml down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "eval:profile": "bun run tests/evals/profile-extraction.eval.ts",
    "ingest": "bun run scripts/ingest.ts",
    "embed": "bun run scripts/embed.ts",
    "eval:match": "bun run tests/evals/match-precision.eval.ts",
    "eval:drafting": "bun run tests/evals/drafting.eval.ts",
    "doctor": "bun run scripts/doctor.ts",
    "refresh": "bun run scripts/refresh.ts",
    "benchmark": "bun run scripts/benchmark-providers.ts",
    "benchmark:local": "bun run scripts/benchmark-local.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.41",
    "@tanstack/react-start": "^1.132.41",
    "exceljs": "^4.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@lovable.dev/lovite": "0.0.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^4.1.9"
  }
}
