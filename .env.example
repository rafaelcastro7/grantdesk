# Copy to .env for local development. Never commit the real file.
# These particular values are the local stack's own dev keys — they are not
# secrets in any meaningful sense, but the file stays gitignored so that habit
# holds when a real key lands here.

# Local stack (see supabase/docker-compose.yml — ports are deliberately unique)
SUPABASE_URL=http://localhost:15535
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:grantdesk-local-postgres-password@localhost:15532/postgres

VITE_SUPABASE_URL=http://localhost:15535
VITE_SUPABASE_ANON_KEY=

# Single sign-on buttons. Set to 1 only once the provider is configured in
# Supabase Auth (docs/auth-sso.md); otherwise the button leads to an error page.
VITE_AUTH_GOOGLE=
VITE_AUTH_AZURE=

# Local inference floor
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud chain. Any provider without a key is skipped rather than failing.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_STUDIO_KEY=
