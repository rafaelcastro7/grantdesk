# Copy to .env for local development. Never commit the real file.
# These particular values are the local stack's own dev keys — they are not
# secrets in any meaningful sense, but the file stays gitignored so that habit
# holds when a real key lands here.

# Local stack (see supabase/docker-compose.yml — ports are deliberately unique)
SUPABASE_URL=http://localhost:15535
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:grantdesk-local-postgres-password@localhost:15532/postgres

VITE_SUPABASE_URL=http://localhost:15535
VITE_SUPABASE_ANON_KEY=

# Local inference floor
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud chain. Any provider without a key is skipped rather than failing.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_STUDIO_KEY=

# ── Hosted deployment (Lovable Cloud) ───────────────────────────────────────
# Lovable provides VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY; both
# spellings are accepted, no renames needed. Leave OLLAMA_BASE_URL unset there.
# Embeddings then come from an OpenAI-compatible endpoint serving the SAME
# models as the stored vectors (bge-m3 1024d, nomic-embed-text v1.5 768d).
EMBED_API_URL=
EMBED_API_KEY=
# EMBED_API_MODEL_CATALOG=BAAI/bge-m3
# EMBED_API_MODEL_ANSWERS=nomic-ai/nomic-embed-text-v1.5
